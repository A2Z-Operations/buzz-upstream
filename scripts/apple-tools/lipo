#!/usr/bin/env bash
# Flutter 3.41 passes multiple architectures to -verify_arch. Xcode 27's
# lipo accepts only one at a time. Preserve the all-architectures requirement.
set -euo pipefail
if [[ $# -ge 3 && "$2" == -verify_arch ]]; then
  binary="$1"
  shift 2
  for architecture in "$@"; do
    xcrun lipo "$binary" -verify_arch "$architecture"
  done
else
  exec xcrun lipo "$@"
fi
